# ── Server environment variables ──────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Server port (default: 5001)
PORT=5001

# MongoDB connection string
# Local:      mongodb://localhost:27017/habitflow
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/habitflow
MONGODB_URI=mongodb://localhost:27017/habitflow

# JWT secret — MUST be changed in production (min 32 chars, random)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION

# JWT token expiry
JWT_EXPIRES_IN=7d

# Client URL(s) for CORS — comma-separated for multiple origins
# Dev:  http://localhost:5173
# Prod: https://yourapp.com,https://www.yourapp.com
CLIENT_URL=http://localhost:5173

# Google Gemini API key (for AI features)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Node environment: development | production | test
NODE_ENV=development
