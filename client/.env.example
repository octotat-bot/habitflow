# ── Client environment variables ──────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# API base URL — used in production when the API is on a different domain.
# In development, Vite's proxy forwards /api/* to localhost:5001.
# In production (separate domains): set this to your API URL.
VITE_API_URL=http://localhost:5001

# App name (optional — used in page titles)
VITE_APP_NAME=HabitFlow
